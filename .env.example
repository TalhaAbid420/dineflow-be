# ============================================================
# Dineflow — environment variables (backend)
# ============================================================
# Copy this file to `.env` and fill in real values.
#
# Where each service reads it from:
#   - Backend (dineflow-be): dineflow-be/.env, or the repo-root .env
#   - docker-compose (dineflow-be/docker-compose.yml): the root `.env`
#   - Frontend (dineflow-fe): dineflow-fe/.env  (only BACKEND_URL is needed)
#
# Locally, the Postgres and Mongo services can be started with:
#   docker compose -f dineflow-be/docker-compose.yml up db mongo -d
# ============================================================

# ------------------------------------------------------------
# LLM / Agent
# ------------------------------------------------------------

# REQUIRED. OpenAI API key used by the Dineflow agent and the
# preferences-extractor memory step. Get one from https://platform.openai.com
OPENAI_API_KEY=

# Model the ordering agent uses. Defaults to GPT-5.
OPENAI_MODEL=gpt-5

# Optional. Point the OpenAI SDK at a compatible gateway / proxy
# (e.g. a region-routed endpoint). Leave empty to use api.openai.com.
OPENAI_BASE_URL=

# ------------------------------------------------------------
# PostgreSQL — short-term memory + menu + ordering
# ------------------------------------------------------------

# REQUIRED. Connection string used by asyncpg. Either a local dev DB
# (docker compose) or a managed Postgres such as Neon.
#   Local:  postgresql://dineflow:dineflow@localhost:5432/dineflow
#   Neon:   postgresql://<user>:<password>@<host>/<db>?sslmode=require
POSTGRES_DATABASE_URL=postgresql://dineflow:dineflow@localhost:5432/dineflow

# ------------------------------------------------------------
# MongoDB — long-term memories / customer preferences
# ------------------------------------------------------------

# REQUIRED. MongoDB connection string. Works with MongoDB Atlas as well as
# the local `mongo` container in docker-compose.
#   Local:  mongodb://localhost:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=dineflow

# ------------------------------------------------------------
# Backend API
# ------------------------------------------------------------

# Comma-separated list of browser origins allowed by CORS.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Seed the sample menu on startup when the menu table is empty.
SEED_MENU_ON_START=true

# Runtime context + logging.
APP_NAME=Dineflow
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Auth
# ------------------------------------------------------------

# REQUIRED in production. Secret used to sign JWTs. Use a random value of at
# least 32 bytes, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Seed credentials for the kitchen dashboard login.
CHEF_EMAIL=chef@gmail.com
CHEF_PASSWORD=chef1234
